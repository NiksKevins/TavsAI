# bot.tavswebs.com — environment template
# Copy to .env.local for local development. Never commit real secrets.

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_WIDGET_URL=http://localhost:3000/widget.js
NEXT_PUBLIC_APP_NAME=TavsWebs Bot

# Database (PostgreSQL with pgvector)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/bot_tavswebs?sslmode=require

# Auth (Auth.js / NextAuth)
AUTH_SECRET=generate-a-long-random-string
AUTH_URL=http://localhost:3000

OPENAI_API_KEY=

# Stripe (server secrets only — never ship to the browser)
# Docs: docs/stripe-billing.md
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_BUSINESS=
STRIPE_PRICE_PRO=
# Must be price_… IDs (not prod_…). Stripe Dashboard → Product → Pricing.

# Calendar / appointments (Google OAuth)
# Redirect URI: {NEXT_PUBLIC_APP_URL}/api/integrations/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 64-char hex or any passphrase — encrypts OAuth tokens at rest
TOKEN_ENCRYPTION_KEY=

# Email / Resend
RESEND_API_KEY=
EMAIL_FROM=Bot <bot@tavswebs.com>

# Sentry (optional — src/instrumentation.ts loads when DSN is set)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
# NEXT_PUBLIC_SENTRY_DSN=

# Background jobs (Inngest)
# Local: npx inngest-cli@latest dev -u http://127.0.0.1:3001/api/inngest
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
